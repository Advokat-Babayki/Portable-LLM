# ============================================================
#  Модели (веса) — слишком большие для Git
# ============================================================
models/
whisper/models/
*.gguf
*.bin
*.safetensors
*.onnx
*.ggml
*.ggjt

# ============================================================
#  Бинарники llama.cpp / Whisper
#  Не хранятся в GitHub — скачиваются скриптами запуска
#  из архива в GitHub Releases (см. README.md)
# ============================================================
bin/**
whisper/bin/**

# Но лицензии бинарников оставляем в репозитории
# (сначала разрешаем git "заглядывать" внутрь папок, затем возвращаем LICENSE)
!bin/**/
!bin/**/LICENSE
!whisper/bin/**/
!whisper/bin/**/LICENSE

# ============================================================
#  Прочее
# ============================================================
logs/
*.log
*.tmp
.DS_Store
Thumbs.db